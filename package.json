{
  "name": "avs-congo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" next dev -p 3003",
    "build": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" next build",
    "start": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" next start",
    "backend:dev": "npm --prefix ../avs-backend run dev",
    "backend:start": "npm --prefix ../avs-backend start",
    "backend:seed": "npm --prefix ../avs-backend run prisma:seed",
    "backend:push": "npx --prefix ../avs-backend prisma db push",
    "backend:studio": "npm --prefix ../avs-backend run prisma:studio",
    "postinstall": "prisma generate",
    "upload-images": "node scripts/upload-cloudinary.js"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.0.0",
    "groq-sdk": "^1.3.0",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "next": "14.2.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.9.2",
    "resend": "^4.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cloudinary": "^2.10.0",
    "prisma": "^6.19.3"
  }
}
